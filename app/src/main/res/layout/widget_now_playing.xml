<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_artwork" android:layout_width="76dp" android:layout_height="76dp" android:contentDescription="@string/widget_album_art" android:scaleType="centerCrop" android:src="@drawable/widget_music_art" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_now_playing" android:textAllCaps="true" android:textColor="#FF03BDE8" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginVertical="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_previous" android:layout_width="56dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/widget_previous" android:src="@drawable/ic_widget_previous" />
        <ImageButton android:id="@+id/widget_play_pause" android:layout_width="64dp" android:layout_height="52dp" android:background="@android:color/transparent" android:contentDescription="@string/widget_play_pause" android:src="@drawable/ic_widget_play" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="56dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="@string/widget_next" android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
